# macOS and local editor state
.DS_Store
.claude/
*.xcuserstate
xcuserdata/

# Credentials and signing material
.env
.env.*
!.env.example
!.env.sample
*.p12
*.p8
*.mobileprovision
*.key

# Reproducible build products and Python caches
build/
DerivedData/
__pycache__/
*.py[cod]
*.app/
*.dSYM/
outputs/**/world-tests
outputs/**/camera-tests
outputs/**/interaction-tests
outputs/**/v4-tests
outputs/**/package-v4
outputs/**/WorldCameraTests
outputs/**/WorldInteractionTests
outputs/**/WorldSimulationTests
outputs/**/WorldV4Tests

# Local simulator recordings; sources and review images remain versioned
outputs/**/*.mp4
outputs/**/*.mov

# Unrelated personal document
/机票行程单_前两页.pdf

# Regenerable intake and review artifacts (rebuilt by assets/tools/intake_*.py and review capture)
assets/registry/
outputs/**/build-*/
outputs/**/capture/*/
outputs/frames-v5-review/tools/frames
outputs/frames-v5-review/tools/export
outputs/rig-v1-review/*__aligned.png
outputs/rig-v1-review/*__deltaE.png

# 构建日志不进仓库；测试原始输出存成 *-tests.txt（已跟踪的旧日志不受影响）
*.log
# 信箱改版验收：原尺寸截图只留本地，提交 *-small.png
outputs/nav-mailbox/review/*.png
!outputs/nav-mailbox/review/*-small.png
# 世界纵深与树窝验收：原尺寸截图只留本地，提交压缩后的 JPEG
outputs/world-depth/review/*.png
outputs/nest-style/review/*.png
